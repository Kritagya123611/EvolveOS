# ──────────────────────────────────────────────
# EvolveOS — Environment Configuration
# Copy this to the relevant .env file and fill in your values.
# ──────────────────────────────────────────────

# ── World Engine & Border API (shared) ──
# Google Gemini API key for LLM inference + embeddings
GEMINI_API_KEY=

# Supabase project credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Redis connection (defaults to localhost:6379 if not set)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Border API port (defaults to 3000 if not set)
PORT=3000
